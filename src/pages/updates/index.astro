---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { UI_TEXT } from '../../data/site';

const allUpdates = await getCollection('updates');
const updates = allUpdates.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const projects = Array.from(new Set(updates.map((u) => u.data.project))).sort();

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<BaseLayout title="Updates Timeline | seldas" description="Chronological engineering milestones and weekly research updates.">
  <div class="container container-narrow">
    <header class="page-header">
      <h1 class="page-title">
        <span data-lang="en">{UI_TEXT.updatesPage.title.en}</span>
        <span data-lang="zh">{UI_TEXT.updatesPage.title.zh}</span>
      </h1>
      <p class="page-subtitle">
        <span data-lang="en">{UI_TEXT.updatesPage.subtitle.en}</span>
        <span data-lang="zh">{UI_TEXT.updatesPage.subtitle.zh}</span>
      </p>
    </header>

    <!-- Search & Project Filters -->
    <div class="filter-bar">
      <input
        type="text"
        id="update-search"
        class="search-input"
        placeholder={UI_TEXT.updatesPage.searchPlaceholder.en}
        data-placeholder-en={UI_TEXT.updatesPage.searchPlaceholder.en}
        data-placeholder-zh={UI_TEXT.updatesPage.searchPlaceholder.zh}
      />
      <span class="count-indicator" id="updates-count">
        {updates.length}
        <span data-lang="en"> {UI_TEXT.updatesPage.showing.en}</span>
        <span data-lang="zh"> {UI_TEXT.updatesPage.showing.zh}</span>
      </span>
    </div>

    <div class="pill-group" style="margin-bottom: 2rem;" role="group" aria-label="Project filter">
      <button type="button" class="pill-btn active" data-project="all">
        <span data-lang="en">{UI_TEXT.updatesPage.allProjects.en}</span>
        <span data-lang="zh">{UI_TEXT.updatesPage.allProjects.zh}</span>
      </button>
      {
        projects.map((proj) => (
          <button type="button" class="pill-btn" data-project={proj}>
            {proj}
          </button>
        ))
      }
    </div>

    <!-- Timeline List -->
    <div class="timeline-list" id="updates-list">
      {
        updates.map((post) => (
          <article
            class="timeline-item"
            data-project={post.data.project}
            data-search={`${post.data.title} ${post.data.project} ${post.data.tags.join(' ')} ${post.data.summary}`.toLowerCase()}
          >
            <div class="timeline-meta">
              <time class="mono-date">{formatDate(post.data.date)}</time>
              <span class="badge badge-accent">{post.data.project}</span>
            </div>
            <h2 class="timeline-title">
              <a href={`/updates/${post.id}`}>{post.data.title}</a>
            </h2>
            {post.data.summary && <p class="timeline-summary">{post.data.summary}</p>}
            {post.data.tags.length > 0 && (
              <div class="tag-row">
                {post.data.tags.map((tag) => (
                  <button type="button" class="badge tag-filter-btn" data-tag={tag.toLowerCase()}>
                    {tag}
                  </button>
                ))}
              </div>
            )}
          </article>
        ))
      }
    </div>
  </div>
</BaseLayout>

<script>
  const searchInput = document.getElementById('update-search') as HTMLInputElement | null;
  const projectBtns = document.querySelectorAll<HTMLButtonElement>('[data-project]');
  const tagBtns = document.querySelectorAll<HTMLButtonElement>('.tag-filter-btn');
  const items = document.querySelectorAll<HTMLElement>('.timeline-item');
  const countEl = document.getElementById('updates-count');

  let activeProject = 'all';

  function filterUpdates() {
    const q = (searchInput?.value || '').trim().toLowerCase();
    let visible = 0;
    items.forEach((el) => {
      const proj = el.dataset.project || '';
      const hay = el.dataset.search || '';
      const okProj = activeProject === 'all' || proj === activeProject;
      const okQuery = !q || hay.includes(q);
      const show = okProj && okQuery;
      el.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    if (countEl) {
      const numNode = countEl.firstChild;
      if (numNode && numNode.nodeType === Node.TEXT_NODE) {
        numNode.textContent = `${visible}`;
      }
    }
  }

  searchInput?.addEventListener('input', filterUpdates);

  projectBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      projectBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      activeProject = btn.dataset.project || 'all';
      filterUpdates();
    });
  });

  tagBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      if (searchInput) {
        searchInput.value = btn.dataset.tag || '';
        filterUpdates();
        searchInput.focus();
      }
    });
  });
</script>

<style>
  .count-indicator {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .timeline-list {
    display: flex;
    flex-direction: column;
  }

  .timeline-item {
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .timeline-item:last-child {
    border-bottom: none;
  }

  .timeline-meta {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .mono-date {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .timeline-title {
    font-size: 1.18rem;
    font-weight: 600;
    margin: 0;
    line-height: 1.35;
  }

  .timeline-title a:hover {
    color: var(--accent);
  }

  .timeline-summary {
    margin: 0.15rem 0 0;
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.58;
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.35rem;
  }

  .tag-filter-btn {
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .tag-filter-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
