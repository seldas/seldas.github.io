---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { UI_TEXT, RESEARCH_FOCUS, PROJECTS } from '../data/site';
import { PUBLICATIONS } from '../data/publications';

const allUpdates = await getCollection('updates');
const latestUpdates = allUpdates
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5);

const flagshipProjects = PROJECTS.filter((p) => p.category === 'flagship');

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<BaseLayout title="seldas | Research Updates">
  <div class="container">
    <!-- Hero -->
    <section class="hero">
      <div class="hero-eyebrow">
        <span data-lang="en">{UI_TEXT.hero.eyebrow.en}</span>
        <span data-lang="zh">{UI_TEXT.hero.eyebrow.zh}</span>
      </div>
      <h1 class="hero-title">
        <span data-lang="en">{UI_TEXT.hero.title.en}</span>
        <span data-lang="zh">{UI_TEXT.hero.title.zh}</span>
      </h1>
      <p class="hero-subtitle">
        <span data-lang="en">{UI_TEXT.hero.subtitle.en}</span>
        <span data-lang="zh">{UI_TEXT.hero.subtitle.zh}</span>
      </p>
      <div class="hero-actions">
        <a href="/projects" class="btn btn-primary">
          <span data-lang="en">{UI_TEXT.hero.ctaProjects.en}</span>
          <span data-lang="zh">{UI_TEXT.hero.ctaProjects.zh}</span>
        </a>
        <a href="/updates" class="btn btn-secondary">
          <span data-lang="en">{UI_TEXT.hero.ctaUpdates.en}</span>
          <span data-lang="zh">{UI_TEXT.hero.ctaUpdates.zh}</span>
        </a>
      </div>
    </section>

    <!-- Research Focus Areas -->
    <section class="section">
      <div class="section-header">
        <h2 class="section-title">
          <span data-lang="en">{UI_TEXT.home.focusTitle.en}</span>
          <span data-lang="zh">{UI_TEXT.home.focusTitle.zh}</span>
        </h2>
        <a href="/research" class="section-link">
          <span data-lang="en">{UI_TEXT.home.allResearch.en}</span>
          <span data-lang="zh">{UI_TEXT.home.allResearch.zh}</span>
        </a>
      </div>
      <div class="grid-2">
        {
          RESEARCH_FOCUS.map((area) => (
            <div class="card focus-card">
              <div class="focus-icon">
                {area.icon === 'file-text' ? (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                  </svg>
                ) : (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M2 15c6.667-6 13.333 0 20-6"></path>
                    <path d="M9 22c1.798-1.998 2.518-3.995 2.807-5.993"></path>
                    <path d="M15 2c-1.798 1.998-2.518 3.995-2.807 5.993"></path>
                    <path d="M2 9c6.667 6 13.333 0 20 6"></path>
                  </svg>
                )}
              </div>
              <h3 class="card-title">
                <span data-lang="en">{area.title.en}</span>
                <span data-lang="zh">{area.title.zh}</span>
              </h3>
              <p class="card-desc">
                <span data-lang="en">{area.description.en}</span>
                <span data-lang="zh">{area.description.zh}</span>
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Featured Projects -->
    <section class="section">
      <div class="section-header">
        <h2 class="section-title">
          <span data-lang="en">{UI_TEXT.home.featuredTitle.en}</span>
          <span data-lang="zh">{UI_TEXT.home.featuredTitle.zh}</span>
        </h2>
        <a href="/projects" class="section-link">
          <span data-lang="en">{UI_TEXT.home.allProjects.en}</span>
          <span data-lang="zh">{UI_TEXT.home.allProjects.zh}</span>
        </a>
      </div>
      <div class="grid-3">
        {
          flagshipProjects.map((project) => (
            <div class="card card-interactive project-card">
              <div class="project-top">
                <span
                  class={`badge ${
                    project.status === 'Active'
                      ? 'badge-active'
                      : project.status === 'Archived'
                        ? 'badge-archived'
                        : 'badge-done'
                  }`}
                >
                  {project.status}
                </span>
                <a
                  href={project.repoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="repo-link"
                  aria-label={`${project.name} GitHub`}
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
                  </svg>
                </a>
              </div>
              <h3 class="project-name">
                <a href={`/projects#${project.id}`}>{project.name}</a>
              </h3>
              <p class="card-desc" style="flex: 1;">
                <span data-lang="en">{project.summary.en}</span>
                <span data-lang="zh">{project.summary.zh}</span>
              </p>
              <div class="tag-row">
                {project.tags.slice(0, 4).map((t) => (
                  <span class="badge">{t}</span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Selected Publications -->
    <section class="section">
      <div class="section-header">
        <h2 class="section-title">
          <span data-lang="en">{UI_TEXT.home.selectedPubs.en}</span>
          <span data-lang="zh">{UI_TEXT.home.selectedPubs.zh}</span>
        </h2>
        <a href="/research" class="section-link">
          <span data-lang="en">{UI_TEXT.home.allResearch.en}</span>
          <span data-lang="zh">{UI_TEXT.home.allResearch.zh}</span>
        </a>
      </div>
      <div class="grid-2">
        {
          PUBLICATIONS.slice(0, 2).map((pub) => (
            <div class="card card-interactive pub-card">
              <div class="pub-meta">
                <span class="badge badge-accent">{pub.journal}</span>
                <span class="mono-date">{pub.date}</span>
              </div>
              <h3 class="pub-title">
                <a href={`/research#${pub.id}`}>
                  <span data-lang="en">{pub.title.en}</span>
                  <span data-lang="zh">{pub.title.zh}</span>
                </a>
              </h3>
              <p class="card-desc">
                <span data-lang="en">{pub.summary.en}</span>
                <span data-lang="zh">{pub.summary.zh}</span>
              </p>
              <div class="tag-row">
                {pub.metrics.map((m) => (
                  <span class="badge">
                    {m.label}: <strong>{m.value}</strong>
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Latest Updates -->
    <section class="section">
      <div class="section-header">
        <h2 class="section-title">
          <span data-lang="en">{UI_TEXT.home.latestUpdates.en}</span>
          <span data-lang="zh">{UI_TEXT.home.latestUpdates.zh}</span>
        </h2>
        <a href="/updates" class="section-link">
          <span data-lang="en">{UI_TEXT.home.fullTimeline.en}</span>
          <span data-lang="zh">{UI_TEXT.home.fullTimeline.zh}</span>
        </a>
      </div>
      <div class="updates-feed">
        {
          latestUpdates.map((post) => (
            <article class="update-row">
              <div class="update-row-meta">
                <time class="mono-date">{formatDate(post.data.date)}</time>
                <span class="badge badge-accent">{post.data.project}</span>
              </div>
              <div class="update-row-body">
                <h3 class="update-row-title">
                  <a href={`/updates/${post.id}`}>{post.data.title}</a>
                </h3>
                {post.data.summary && <p class="update-row-summary">{post.data.summary}</p>}
              </div>
              <a href={`/updates/${post.id}`} class="update-row-link">
                <span data-lang="en">{UI_TEXT.home.readLog.en}</span>
                <span data-lang="zh">{UI_TEXT.home.readLog.zh}</span>
              </a>
            </article>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    padding: 4rem 0 2.5rem;
    max-width: 740px;
  }

  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: 0.9rem;
    font-weight: 500;
  }

  .hero-title {
    font-size: clamp(2rem, 4vw, 2.85rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.12;
    margin: 0 0 1.1rem;
  }

  .hero-subtitle {
    font-size: 1.08rem;
    color: var(--text-secondary);
    line-height: 1.68;
    margin: 0 0 1.85rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .focus-card {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .focus-icon {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-sm);
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
  }

  .card-title {
    font-size: 1.08rem;
    font-weight: 600;
    margin: 0;
  }

  .card-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.58;
    margin: 0;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .project-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .repo-link {
    color: var(--text-muted);
    transition: color 0.15s ease;
  }

  .repo-link:hover {
    color: var(--accent);
  }

  .project-name {
    font-size: 1.15rem;
    font-weight: 600;
    margin: 0;
  }

  .project-name a:hover {
    color: var(--accent);
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.4rem;
  }

  .pub-card {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .pub-meta {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .pub-title {
    font-size: 1.08rem;
    font-weight: 600;
    line-height: 1.38;
    margin: 0;
  }

  .pub-title a:hover {
    color: var(--accent);
  }

  .mono-date {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .updates-feed {
    display: flex;
    flex-direction: column;
  }

  .update-row {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .update-row:last-child {
    border-bottom: none;
  }

  .update-row-meta {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .update-row-title {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0;
  }

  .update-row-title a:hover {
    color: var(--accent);
  }

  .update-row-summary {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin: 0.3rem 0 0;
    line-height: 1.55;
  }

  .update-row-link {
    font-size: 0.84rem;
    font-weight: 500;
    color: var(--accent);
    width: fit-content;
  }

  .update-row-link:hover {
    text-decoration: underline;
  }
</style>
