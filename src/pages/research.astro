---
import BaseLayout from '../layouts/BaseLayout.astro';
import { UI_TEXT } from '../data/site';
import { PUBLICATIONS } from '../data/publications';
import essays from '../data/essays.json';
---

<BaseLayout title="Research & Publications | seldas" description="Peer-reviewed publications and technical deep dives in regulatory AI, pharmacovigilance, and clinical NLP.">
  <div class="container container-narrow">
    <header class="page-header">
      <h1 class="page-title">
        <span data-lang="en">{UI_TEXT.researchPage.title.en}</span>
        <span data-lang="zh">{UI_TEXT.researchPage.title.zh}</span>
      </h1>
      <p class="page-subtitle">
        <span data-lang="en">{UI_TEXT.researchPage.subtitle.en}</span>
        <span data-lang="zh">{UI_TEXT.researchPage.subtitle.zh}</span>
      </p>
    </header>

    <!-- Peer-Reviewed Publications -->
    <section class="section" style="padding-top: 0.5rem;">
      <div class="section-header">
        <h2 class="section-title">
          <span data-lang="en">{UI_TEXT.researchPage.pubsHeading.en}</span>
          <span data-lang="zh">{UI_TEXT.researchPage.pubsHeading.zh}</span>
        </h2>
      </div>

      <div class="research-stack">
        {
          PUBLICATIONS.map((pub) => (
            <article id={pub.id} class="card pub-article">
              <div class="pub-header">
                <div class="pub-badges">
                  <span class="badge badge-accent">{pub.journal}</span>
                  <span class="mono-date">{pub.date}</span>
                </div>
                <a href={pub.doiUrl} target="_blank" rel="noopener noreferrer" class="doi-link">
                  DOI: {pub.doi} ↗
                </a>
              </div>

              <h3 class="pub-heading">
                <span data-lang="en">{pub.title.en}</span>
                <span data-lang="zh">{pub.title.zh}</span>
              </h3>
              <p class="pub-original">{pub.originalTitle}</p>
              <p class="pub-authors">{pub.authors}</p>

              <div class="metrics-row">
                {pub.metrics.map((m) => (
                  <div class="metric-pill">
                    <span class="metric-label">{m.label}</span>
                    <span class="metric-val">{m.value}</span>
                  </div>
                ))}
              </div>

              <div class="plain-summary">
                <h4>
                  <span data-lang="en">{UI_TEXT.researchPage.plainSummary.en}</span>
                  <span data-lang="zh">{UI_TEXT.researchPage.plainSummary.zh}</span>
                </h4>
                <p>
                  <span data-lang="en">{pub.summary.en}</span>
                  <span data-lang="zh">{pub.summary.zh}</span>
                </p>
                <ul data-lang="en">
                  {pub.bullets.en.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
                <ul data-lang="zh">
                  {pub.bullets.zh.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Technical Essays -->
    <section class="section">
      <div class="section-header">
        <h2 class="section-title">
          <span data-lang="en">{UI_TEXT.researchPage.essaysHeading.en}</span>
          <span data-lang="zh">{UI_TEXT.researchPage.essaysHeading.zh}</span>
        </h2>
      </div>

      <div class="research-stack">
        {
          essays.map((essay, idx) => (
            <article id={essay.id} class="card essay-card">
              <div class="pub-badges" style="margin-bottom: 0.6rem;">
                <span class="badge badge-accent">askFDALabel 3.0</span>
                <span class="mono-date">{essay.date}</span>
              </div>
              <h3 class="pub-heading" style="margin-bottom: 0.9rem;">{essay.title}</h3>
              <details open={idx === 0} class="essay-details">
                <summary class="essay-toggle">
                  <span data-lang="en">Toggle full article</span>
                  <span data-lang="zh">展开 / 收起全文</span>
                </summary>
                <div class="prose essay-body" data-lang="en" set:html={essay.htmlEn} />
                <div class="prose essay-body" data-lang="zh" set:html={essay.htmlZh} />
              </details>
            </article>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .research-stack {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .pub-article,
  .essay-card {
    padding: 1.65rem;
  }

  .pub-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
  }

  .pub-badges {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .mono-date {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .doi-link {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--accent);
  }

  .doi-link:hover {
    text-decoration: underline;
  }

  .pub-heading {
    font-size: 1.32rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.02em;
    margin: 0 0 0.45rem;
  }

  .pub-original {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.94rem;
    color: var(--text-secondary);
    margin: 0 0 0.35rem;
  }

  .pub-authors {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0 0 1.1rem;
  }

  .metrics-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-bottom: 1.25rem;
  }

  .metric-pill {
    display: flex;
    flex-direction: column;
    padding: 0.5rem 0.85rem;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }

  .metric-label {
    font-size: 0.72rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .metric-val {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .plain-summary {
    border-top: 1px solid var(--border);
    padding-top: 1rem;
  }

  .plain-summary h4 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    margin: 0 0 0.5rem;
  }

  .plain-summary p {
    font-size: 0.94rem;
    color: var(--text-secondary);
    margin: 0 0 0.75rem;
  }

  .plain-summary ul {
    margin: 0;
    padding-left: 1.2rem;
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .plain-summary li {
    margin-bottom: 0.4rem;
  }

  .essay-toggle {
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--accent);
    padding: 0.4rem 0;
    user-select: none;
  }

  .essay-body {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
</style>
