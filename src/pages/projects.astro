---
import BaseLayout from '../layouts/BaseLayout.astro';
import { UI_TEXT, PROJECTS } from '../data/site';

const flagship = PROJECTS.filter((p) => p.category === 'flagship');
const repositories = PROJECTS.filter((p) => p.category === 'repository');
---

<BaseLayout title="Projects | seldas" description="Open-source software, deep learning models, and clinical NLP platforms developed by seldas.">
  <div class="container">
    <header class="page-header">
      <h1 class="page-title">
        <span data-lang="en">{UI_TEXT.projectsPage.title.en}</span>
        <span data-lang="zh">{UI_TEXT.projectsPage.title.zh}</span>
      </h1>
      <p class="page-subtitle">
        <span data-lang="en">{UI_TEXT.projectsPage.subtitle.en}</span>
        <span data-lang="zh">{UI_TEXT.projectsPage.subtitle.zh}</span>
      </p>
    </header>

    <!-- Filter Bar -->
    <div class="filter-bar">
      <input
        type="text"
        id="project-search"
        class="search-input"
        placeholder={UI_TEXT.projectsPage.searchPlaceholder.en}
        data-placeholder-en={UI_TEXT.projectsPage.searchPlaceholder.en}
        data-placeholder-zh={UI_TEXT.projectsPage.searchPlaceholder.zh}
      />
      <div class="pill-group" role="group" aria-label="Status filter">
        <button type="button" class="pill-btn active" data-status="all">
          <span data-lang="en">{UI_TEXT.projectsPage.statusAll.en}</span>
          <span data-lang="zh">{UI_TEXT.projectsPage.statusAll.zh}</span>
        </button>
        <button type="button" class="pill-btn" data-status="Active">
          <span data-lang="en">{UI_TEXT.projectsPage.statusActive.en}</span>
          <span data-lang="zh">{UI_TEXT.projectsPage.statusActive.zh}</span>
        </button>
        <button type="button" class="pill-btn" data-status="Completed">
          <span data-lang="en">{UI_TEXT.projectsPage.statusCompleted.en}</span>
          <span data-lang="zh">{UI_TEXT.projectsPage.statusCompleted.zh}</span>
        </button>
        <button type="button" class="pill-btn" data-status="Archived">
          <span data-lang="en">{UI_TEXT.projectsPage.statusArchived.en}</span>
          <span data-lang="zh">{UI_TEXT.projectsPage.statusArchived.zh}</span>
        </button>
      </div>
    </div>

    <!-- Flagship Platforms & Models -->
    <section class="section" style="padding-top: 0.5rem;">
      <div class="section-header">
        <h2 class="section-title">
          <span data-lang="en">{UI_TEXT.projectsPage.flagshipHeading.en}</span>
          <span data-lang="zh">{UI_TEXT.projectsPage.flagshipHeading.zh}</span>
        </h2>
      </div>
      <div class="flagship-list" id="flagship-grid">
        {
          flagship.map((p) => (
            <article
              id={p.id}
              class="card flagship-card project-item"
              data-status={p.status}
              data-search={`${p.name} ${p.summary.en} ${p.summary.zh} ${p.tags.join(' ')} ${p.language || ''}`.toLowerCase()}
            >
              <div class="flagship-head">
                <div class="flagship-meta">
                  <span
                    class={`badge ${
                      p.status === 'Active'
                        ? 'badge-active'
                        : p.status === 'Archived'
                          ? 'badge-archived'
                          : 'badge-done'
                    }`}
                  >
                    {p.status}
                  </span>
                  {p.language && <span class="badge">{p.language}</span>}
                  {p.updatedAt && <span class="mono-date">Updated {p.updatedAt}</span>}
                </div>
                <a href={p.repoUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
                  </svg>
                  <span data-lang="en">{UI_TEXT.projectsPage.sourceCode.en}</span>
                  <span data-lang="zh">{UI_TEXT.projectsPage.sourceCode.zh}</span>
                </a>
              </div>

              <h3 class="flagship-title">{p.name}</h3>
              <p class="flagship-summary">
                <span data-lang="en">{p.description?.en || p.summary.en}</span>
                <span data-lang="zh">{p.description?.zh || p.summary.zh}</span>
              </p>

              {p.highlights && p.highlights.length > 0 && (
                <div class="highlights-grid">
                  {p.highlights.map((h) => (
                    <div class="highlight-box">
                      <h4>
                        <span data-lang="en">{h.title.en}</span>
                        <span data-lang="zh">{h.title.zh}</span>
                      </h4>
                      <p>
                        <span data-lang="en">{h.detail.en}</span>
                        <span data-lang="zh">{h.detail.zh}</span>
                      </p>
                    </div>
                  ))}
                </div>
              )}

              <div class="tag-row">
                {p.tags.map((tag) => (
                  <span class="badge">{tag}</span>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Additional Open-Source Repositories -->
    <section class="section">
      <div class="section-header">
        <h2 class="section-title">
          <span data-lang="en">{UI_TEXT.projectsPage.reposHeading.en}</span>
          <span data-lang="zh">{UI_TEXT.projectsPage.reposHeading.zh}</span>
        </h2>
      </div>
      <div class="grid-3" id="repos-grid">
        {
          repositories.map((p) => (
            <article
              id={p.id}
              class="card card-interactive repo-card project-item"
              data-status={p.status}
              data-search={`${p.name} ${p.summary.en} ${p.summary.zh} ${p.tags.join(' ')} ${p.language || ''}`.toLowerCase()}
            >
              <div class="flagship-head">
                <span
                  class={`badge ${
                    p.status === 'Active'
                      ? 'badge-active'
                      : p.status === 'Archived'
                        ? 'badge-archived'
                        : 'badge-done'
                  }`}
                >
                  {p.status}
                </span>
                <a href={p.repoUrl} target="_blank" rel="noopener noreferrer" class="repo-link" aria-label={p.name}>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                    <polyline points="15 3 21 3 21 9"></polyline>
                    <line x1="10" y1="14" x2="21" y2="3"></line>
                  </svg>
                </a>
              </div>
              <h3 class="repo-title">
                <a href={p.repoUrl} target="_blank" rel="noopener noreferrer">{p.name}</a>
              </h3>
              <p class="repo-summary">
                <span data-lang="en">{p.summary.en}</span>
                <span data-lang="zh">{p.summary.zh}</span>
              </p>
              <div class="tag-row">
                {p.tags.map((tag) => (
                  <span class="badge">{tag}</span>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const searchEl = document.getElementById('project-search') as HTMLInputElement | null;
  const statusBtns = document.querySelectorAll<HTMLButtonElement>('[data-status]');
  const items = document.querySelectorAll<HTMLElement>('.project-item');

  let activeStatus = 'all';

  function applyFilter() {
    const q = (searchEl?.value || '').trim().toLowerCase();
    items.forEach((el) => {
      const st = el.dataset.status || '';
      const hay = el.dataset.search || '';
      const matchStatus = activeStatus === 'all' || st === activeStatus;
      const matchQuery = !q || hay.includes(q);
      el.style.display = matchStatus && matchQuery ? '' : 'none';
    });
  }

  searchEl?.addEventListener('input', applyFilter);
  statusBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      statusBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      activeStatus = btn.dataset.status || 'all';
      applyFilter();
    });
  });
</script>

<style>
  .flagship-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .flagship-card {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.6rem;
  }

  .flagship-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .flagship-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .btn-sm {
    padding: 0.35rem 0.7rem;
    font-size: 0.78rem;
  }

  .flagship-title {
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .flagship-summary {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.96rem;
    line-height: 1.65;
  }

  .highlights-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.85rem;
    margin: 0.25rem 0;
  }

  .highlight-box {
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.85rem 1rem;
  }

  .highlight-box h4 {
    margin: 0 0 0.35rem;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .highlight-box p {
    margin: 0;
    font-size: 0.82rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.25rem;
  }

  .repo-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .repo-title {
    margin: 0;
    font-size: 1.08rem;
    font-weight: 600;
  }

  .repo-title a:hover,
  .repo-link:hover {
    color: var(--accent);
  }

  .repo-link {
    color: var(--text-muted);
  }

  .repo-summary {
    margin: 0;
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.55;
    flex: 1;
  }

  .mono-date {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-muted);
  }
</style>
